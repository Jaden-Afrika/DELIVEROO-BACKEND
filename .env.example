# PostgreSQL connection
POSTGRES_DB=deliveroo_dev
POSTGRES_USER=deliveroo
POSTGRES_PASSWORD=deliveroo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# JWT / Django secret
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRES=86400

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Provider toggles
GEOCODING_PROVIDER=stub
ROUTING_PROVIDER=stub
PAYMENT_PROVIDER=stub
STORAGE_PROVIDER=local

# Set GEOCODING_PROVIDER=google and/or ROUTING_PROVIDER=google to use
# real Google Maps data instead of the fixed stub coordinates. Needs a
# server-side key (IP-restricted, Geocoding API + Directions API
# enabled) - not the same key as the frontend's browser-restricted
# VITE_GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_API_KEY=

# Email notifications (sent when admin changes a parcel's status or
# location). Set NOTIFICATION_PROVIDER=email to actually send; defaults
# to "stub" so no email setup is required for local dev.
NOTIFICATION_PROVIDER=stub
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@deliveroo.local
