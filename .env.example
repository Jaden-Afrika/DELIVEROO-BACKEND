# PostgreSQL connection
# DATABASE_URL takes precedence when set (for example, a Neon connection URL).
POSTGRES_DB=deliveroo_dev
POSTGRES_USER=deliveroo
POSTGRES_PASSWORD=deliveroo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django
DJANGO_DEBUG=1
# Hostnames only (ports are not included): backend defaults to localhost:5000.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# JWT / Django secret
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRES=86400

# CORS
# Vite's default development server origin.
FRONTEND_ORIGIN=http://localhost:5173

# Provider toggles
GEOCODING_PROVIDER=osm
ROUTING_PROVIDER=osm
PAYMENT_PROVIDER=stub
STORAGE_PROVIDER=local

# OpenStreetMap providers use Nominatim (geocoding) and OSRM (routing) with
# no API key. Set either provider to "stub" for deterministic offline tests.

# Email notifications (sent when admin changes a parcel's status or
# location). Set NOTIFICATION_PROVIDER=email to actually send; defaults
# to "stub" so no email setup is required for local dev.
NOTIFICATION_PROVIDER=stub
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@deliveroo.local
